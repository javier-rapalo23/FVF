generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  EMPLEADO_CAJA
}

enum TipoCliente {
  MINORISTA
  MAYORISTA
}

enum UnidadVenta {
  PESO
  UNIDAD
  PAQUETE
}

enum Canal {
  LOCAL
  PEDIDO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  FIADO
}

enum TipoMovimientoCuenta {
  CARGO
  ABONO
  /// Reversa del cargo de una venta a fiado anulada. No es dinero cobrado.
  ANULACION
}

enum TipoMovimientoProveedor {
  CARGO
  PAGO
}

enum CategoriaGasto {
  OPERATIVO
  MERCADERIA
  ADMINISTRATIVO
}

model Sucursal {
  id        Int      @id @default(autoincrement())
  nombre    String
  direccion String?
  creadoEn  DateTime @default(now())

  usuarios    Usuario[]
  stock       Stock[]
  ventas      Venta[]
  compras     Compra[]
  cierresCaja CierreCaja[]
  gastos      Gasto[]
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model Proveedor {
  id       Int     @id @default(autoincrement())
  nombre   String
  telefono String?
  activo   Boolean @default(true)

  productos            Producto[]
  compras              Compra[]
  movimientosProveedor MovimientoProveedor[]
}

model Producto {
  id               Int         @id @default(autoincrement())
  idInterno        Int         @unique
  codigoBarras     String?     @unique
  nombre           String
  categoriaId      Int
  categoria        Categoria   @relation(fields: [categoriaId], references: [id])
  proveedorId      Int?
  proveedor        Proveedor?  @relation(fields: [proveedorId], references: [id])
  unidadVenta      UnidadVenta
  precioMinorista  Decimal     @db.Decimal(10, 2)
  precioMayorista  Decimal     @db.Decimal(10, 2)
  fechaVencimiento DateTime?
  activo           Boolean     @default(true)
  creadoEn         DateTime    @default(now())

  stock          Stock[]
  detallesVenta  DetalleVenta[]
  detallesCompra DetalleCompra[]
}

model Stock {
  id         Int      @id @default(autoincrement())
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  cantidad   Decimal  @db.Decimal(10, 3)

  @@unique([productoId, sucursalId])
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nombre       String
  email        String    @unique
  passwordHash String
  rol          Rol
  sucursalId   Int?
  sucursal     Sucursal? @relation(fields: [sucursalId], references: [id])
  activo       Boolean   @default(true)
  creadoEn     DateTime  @default(now())

  ventas      Venta[]
  compras     Compra[]
  cierresCaja CierreCaja[]
  gastos      Gasto[]
  anulaciones AnulacionVenta[]
}

model Cliente {
  id              Int         @id @default(autoincrement())
  nombre          String
  tipo            TipoCliente @default(MINORISTA)
  /// Si el cliente puede comprar fiado. El tope lo fija `limiteCredito`; sin límite = sin tope.
  fiadoHabilitado Boolean     @default(false)
  limiteCredito   Decimal?    @db.Decimal(10, 2)
  telefono        String?
  activo          Boolean     @default(true)
  creadoEn        DateTime    @default(now())

  ventas            Venta[]
  movimientosCuenta MovimientoCuenta[]
}

model Venta {
  id                Int        @id @default(autoincrement())
  fecha             DateTime   @default(now())
  clienteId         Int?
  cliente           Cliente?   @relation(fields: [clienteId], references: [id])
  usuarioId         Int
  usuario           Usuario    @relation(fields: [usuarioId], references: [id])
  sucursalId        Int
  sucursal          Sucursal   @relation(fields: [sucursalId], references: [id])
  canal             Canal
  metodoPago        MetodoPago
  total             Decimal    @db.Decimal(10, 2)
  /// Bandera para filtrar rápido; el detalle de la anulación vive en `AnulacionVenta`.
  anulada           Boolean    @default(false)
  /// Generada en el cliente por cada carrito: un reintento no duplica la venta.
  claveIdempotencia String     @unique
  notas             String?
  creadoEn          DateTime   @default(now())
  /// Cobrada sin conexión y sincronizada después. `fecha` es la del dispositivo.
  origenOffline     Boolean    @default(false)
  /// Venta offline registrada aunque incumplía una regla vigente al sincronizar.
  requiereRevision  Boolean    @default(false)
  /// Por qué se marcó para revisión.
  observacionSync   String?

  detalles          DetalleVenta[]
  movimientosCuenta MovimientoCuenta[]
  anulacion         AnulacionVenta?

  @@index([sucursalId, fecha])
}

model AnulacionVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @unique
  venta          Venta    @relation(fields: [ventaId], references: [id])
  usuarioId      Int
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  motivo         String
  reingresaStock Boolean
  fecha          DateTime @default(now())
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Decimal  @db.Decimal(10, 3)
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
}

model Compra {
  id          Int       @id @default(autoincrement())
  fecha       DateTime  @default(now())
  proveedorId Int
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])
  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  sucursalId  Int
  sucursal    Sucursal  @relation(fields: [sucursalId], references: [id])
  total       Decimal   @db.Decimal(10, 2)

  detalles             DetalleCompra[]
  movimientosProveedor MovimientoProveedor[]
}

model DetalleCompra {
  id            Int      @id @default(autoincrement())
  compraId      Int
  compra        Compra   @relation(fields: [compraId], references: [id])
  productoId    Int
  producto      Producto @relation(fields: [productoId], references: [id])
  cantidad      Decimal  @db.Decimal(10, 3)
  costoUnitario Decimal  @db.Decimal(10, 2)
}

model MovimientoCuenta {
  id        Int                  @id @default(autoincrement())
  clienteId Int
  cliente   Cliente              @relation(fields: [clienteId], references: [id])
  ventaId   Int?
  venta     Venta?               @relation(fields: [ventaId], references: [id])
  tipo      TipoMovimientoCuenta
  monto     Decimal              @db.Decimal(10, 2)
  fecha     DateTime             @default(now())

  @@index([clienteId])
}

model MovimientoProveedor {
  id          Int                     @id @default(autoincrement())
  proveedorId Int
  proveedor   Proveedor               @relation(fields: [proveedorId], references: [id])
  compraId    Int?
  compra      Compra?                 @relation(fields: [compraId], references: [id])
  tipo        TipoMovimientoProveedor
  monto       Decimal                 @db.Decimal(10, 2)
  fecha       DateTime                @default(now())
}

model CierreCaja {
  id           Int      @id @default(autoincrement())
  fecha        DateTime @default(now())
  usuarioId    Int
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  sucursalId   Int
  sucursal     Sucursal @relation(fields: [sucursalId], references: [id])
  totalSistema Decimal  @db.Decimal(10, 2)
  totalContado Decimal  @db.Decimal(10, 2)
  diferencia   Decimal  @db.Decimal(10, 2)
}

model Gasto {
  id          Int            @id @default(autoincrement())
  fecha       DateTime       @default(now())
  categoria   CategoriaGasto
  monto       Decimal        @db.Decimal(10, 2)
  usuarioId   Int
  usuario     Usuario        @relation(fields: [usuarioId], references: [id])
  sucursalId  Int?
  sucursal    Sucursal?      @relation(fields: [sucursalId], references: [id])
  descripcion String?
}
