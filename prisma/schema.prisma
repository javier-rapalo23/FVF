generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  EMPLEADO_CAJA
}

enum TipoCliente {
  MINORISTA
  MAYORISTA
}

enum UnidadVenta {
  PESO
  UNIDAD
  PAQUETE
}

enum Canal {
  LOCAL
  PEDIDO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  FIADO
}

enum TipoMovimientoCuenta {
  CARGO
  ABONO
  /// Reversa del cargo de una venta a fiado anulada. No es dinero cobrado.
  ANULACION
}

enum TipoMovimientoProveedor {
  CARGO
  PAGO
  /// Reversa del cargo de una compra a crédito anulada. No es dinero pagado.
  ANULACION
}

enum CondicionPago {
  CONTADO
  CREDITO
}

enum TipoAjusteStock {
  /// Conteo físico: se fija la cantidad real y se guarda la diferencia.
  CONTEO
  /// Producto que se pierde: dañado, vencido, robado.
  MERMA
}

enum CategoriaGasto {
  OPERATIVO
  /// Costos ligados a la mercadería que no entran al stock (fletes, bolsas, hielo).
  MERCADERIA
  ADMINISTRATIVO
}

/// Cómo pagó un cliente un abono a su cuenta. El efectivo entra al cajón de la sucursal.
enum MedioAbono {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

/// Cómo se le pagó a un proveedor. Solo `EFECTIVO_CAJA` sale del cajón de ventas.
enum MedioPagoProveedor {
  EFECTIVO_CAJA
  EFECTIVO_FUERA_CAJA
  TRANSFERENCIA
}

enum MedioPagoGasto {
  /// Sale del cajón de ventas de la sucursal: resta en el cierre de caja.
  EFECTIVO_CAJA
  /// Efectivo que no sale del cajón (lo pone el dueño, caja fuerte).
  EFECTIVO_FUERA_CAJA
  TRANSFERENCIA
  TARJETA
}

model Sucursal {
  id        Int      @id @default(autoincrement())
  nombre    String
  direccion String?
  creadoEn  DateTime @default(now())

  usuarios     Usuario[]
  stock        Stock[]
  ventas       Venta[]
  compras      Compra[]
  cierresCaja  CierreCaja[]
  gastos       Gasto[]
  gastosFijos  GastoFijo[]
  ajustesStock AjusteStock[]

  abonos         MovimientoCuenta[]
  pagosProveedor MovimientoProveedor[]
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model Proveedor {
  id            Int     @id @default(autoincrement())
  nombre        String
  telefono      String?
  /// RTN hondureño: 14 dígitos, guardado sin guiones.
  rtn           String?
  direccion     String?
  correo        String?
  observaciones String?
  activo        Boolean @default(true)

  productos            Producto[]
  compras              Compra[]
  movimientosProveedor MovimientoProveedor[]
}

model Producto {
  id               Int         @id @default(autoincrement())
  idInterno        Int         @unique
  codigoBarras     String?     @unique
  nombre           String
  categoriaId      Int
  categoria        Categoria   @relation(fields: [categoriaId], references: [id])
  proveedorId      Int?
  proveedor        Proveedor?  @relation(fields: [proveedorId], references: [id])
  unidadVenta      UnidadVenta
  precioMinorista  Decimal     @db.Decimal(10, 2)
  precioMayorista  Decimal     @db.Decimal(10, 2)
  fechaVencimiento DateTime?
  /// Costo unitario de la última compra registrada. Nulo si nunca se compró.
  costoActual      Decimal?    @db.Decimal(10, 2)
  /// Debajo de esta cantidad el producto aparece como "stock bajo". Nulo = sin alerta.
  stockMinimo      Decimal?    @db.Decimal(10, 3)
  observaciones    String?
  activo           Boolean     @default(true)
  creadoEn         DateTime    @default(now())

  stock          Stock[]
  detallesVenta  DetalleVenta[]
  detallesCompra DetalleCompra[]
  ajustesStock   AjusteStock[]
}

model Stock {
  id         Int      @id @default(autoincrement())
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  cantidad   Decimal  @db.Decimal(10, 3)

  @@unique([productoId, sucursalId])
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nombre       String
  email        String    @unique
  passwordHash String
  rol          Rol
  sucursalId   Int?
  sucursal     Sucursal? @relation(fields: [sucursalId], references: [id])
  activo       Boolean   @default(true)
  creadoEn     DateTime  @default(now())

  ventas      Venta[]
  compras     Compra[]
  cierresCaja CierreCaja[]     @relation("CierresRegistrados")
  gastos      Gasto[]
  anulaciones AnulacionVenta[]

  cierresRevisados  CierreCaja[]          @relation("CierresRevisados")
  anulacionesCompra AnulacionCompra[]
  ajustesStock      AjusteStock[]
  anulacionesGasto  AnulacionGasto[]
  abonos            MovimientoCuenta[]    @relation("AbonosRegistrados")
  pagosProveedor    MovimientoProveedor[] @relation("PagosRegistrados")
  abonosAnulados    MovimientoCuenta[]    @relation("AbonosAnulados")
  pagosAnulados     MovimientoProveedor[] @relation("PagosAnulados")
}

model Cliente {
  id              Int         @id @default(autoincrement())
  nombre          String
  tipo            TipoCliente @default(MINORISTA)
  /// Si el cliente puede comprar fiado. El tope lo fija `limiteCredito`; sin límite = sin tope.
  fiadoHabilitado Boolean     @default(false)
  limiteCredito   Decimal?    @db.Decimal(10, 2)
  telefono        String?
  /// RTN hondureño: 14 dígitos, guardado sin guiones.
  rtn             String?
  direccion       String?
  correo          String?
  observaciones   String?
  activo          Boolean     @default(true)
  creadoEn        DateTime    @default(now())

  ventas            Venta[]
  movimientosCuenta MovimientoCuenta[]
}

model Venta {
  id                Int         @id @default(autoincrement())
  fecha             DateTime    @default(now())
  clienteId         Int?
  cliente           Cliente?    @relation(fields: [clienteId], references: [id])
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  sucursalId        Int
  sucursal          Sucursal    @relation(fields: [sucursalId], references: [id])
  canal             Canal
  metodoPago        MetodoPago
  total             Decimal     @db.Decimal(10, 2)
  /// Bandera para filtrar rápido; el detalle de la anulación vive en `AnulacionVenta`.
  anulada           Boolean     @default(false)
  /// Generada en el cliente por cada carrito: un reintento no duplica la venta.
  claveIdempotencia String      @unique
  notas             String?
  creadoEn          DateTime    @default(now())
  /// Cobrada sin conexión y sincronizada después. `fecha` es la del dispositivo.
  origenOffline     Boolean     @default(false)
  /// Venta offline registrada aunque incumplía una regla vigente al sincronizar.
  requiereRevision  Boolean     @default(false)
  /// Por qué se marcó para revisión.
  observacionSync   String?
  /// Cierre de caja que la incluyó. Nulo = todavía no se cerró.
  cierreCajaId      Int?
  cierreCaja        CierreCaja? @relation(fields: [cierreCajaId], references: [id])

  detalles          DetalleVenta[]
  movimientosCuenta MovimientoCuenta[]
  anulacion         AnulacionVenta?

  @@index([sucursalId, fecha])
  /// Ventas pendientes de cierre de una sucursal.
  @@index([sucursalId, cierreCajaId])
}

model AnulacionVenta {
  id             Int         @id @default(autoincrement())
  ventaId        Int         @unique
  venta          Venta       @relation(fields: [ventaId], references: [id])
  usuarioId      Int
  usuario        Usuario     @relation(fields: [usuarioId], references: [id])
  motivo         String
  reingresaStock Boolean
  fecha          DateTime    @default(now())
  /// Cierre de caja que la incluyó. Si la venta era de un cierre anterior y en
  /// efectivo, ese cierre la descuenta como devolución.
  cierreCajaId   Int?
  cierreCaja     CierreCaja? @relation(fields: [cierreCajaId], references: [id])

  @@index([cierreCajaId])
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Decimal  @db.Decimal(10, 3)
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)

  /// Historial de movimientos por producto (kardex).
  @@index([productoId])
}

model Compra {
  id                Int           @id @default(autoincrement())
  /// Día de la factura, guardado al mediodía local. La hora real de registro es `creadoEn`.
  fecha             DateTime
  proveedorId       Int
  proveedor         Proveedor     @relation(fields: [proveedorId], references: [id])
  usuarioId         Int
  usuario           Usuario       @relation(fields: [usuarioId], references: [id])
  sucursalId        Int
  sucursal          Sucursal      @relation(fields: [sucursalId], references: [id])
  total             Decimal       @db.Decimal(10, 2)
  numeroFactura     String?
  condicionPago     CondicionPago
  notas             String?
  /// Generada al abrir el formulario: un doble envío no duplica la compra.
  claveIdempotencia String        @unique
  /// Bandera para filtrar rápido; el detalle vive en `AnulacionCompra`.
  anulada           Boolean       @default(false)
  creadoEn          DateTime      @default(now())

  detalles             DetalleCompra[]
  movimientosProveedor MovimientoProveedor[]
  anulacion            AnulacionCompra?

  @@index([sucursalId, fecha])
  @@index([proveedorId])
}

model AnulacionCompra {
  id        Int      @id @default(autoincrement())
  compraId  Int      @unique
  compra    Compra   @relation(fields: [compraId], references: [id])
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  motivo    String
  fecha     DateTime @default(now())
}

model DetalleCompra {
  id            Int      @id @default(autoincrement())
  compraId      Int
  compra        Compra   @relation(fields: [compraId], references: [id])
  productoId    Int
  producto      Producto @relation(fields: [productoId], references: [id])
  cantidad      Decimal  @db.Decimal(10, 3)
  costoUnitario Decimal  @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(10, 2)

  /// Historial de movimientos por producto (kardex).
  @@index([productoId])
}

/// Conteo físico o merma. Nunca se edita ni se borra: un error se corrige con otro ajuste.
model AjusteStock {
  id              Int             @id @default(autoincrement())
  productoId      Int
  producto        Producto        @relation(fields: [productoId], references: [id])
  sucursalId      Int
  sucursal        Sucursal        @relation(fields: [sucursalId], references: [id])
  usuarioId       Int
  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  tipo            TipoAjusteStock
  /// Diferencia aplicada al stock: positiva suma, negativa resta.
  cantidad        Decimal         @db.Decimal(10, 3)
  stockAnterior   Decimal         @db.Decimal(10, 3)
  stockResultante Decimal         @db.Decimal(10, 3)
  motivo          String
  fecha           DateTime        @default(now())

  @@index([productoId, sucursalId, fecha])
}

model MovimientoCuenta {
  id        Int                  @id @default(autoincrement())
  clienteId Int
  cliente   Cliente              @relation(fields: [clienteId], references: [id])
  ventaId   Int?
  venta     Venta?               @relation(fields: [ventaId], references: [id])
  tipo      TipoMovimientoCuenta
  monto     Decimal              @db.Decimal(10, 2)
  fecha     DateTime             @default(now())

  // Solo abonos. Los cargos y anulaciones salen de la venta.
  medioPago         MedioAbono?
  usuarioId         Int?
  usuario           Usuario?    @relation("AbonosRegistrados", fields: [usuarioId], references: [id])
  /// Caja que recibió el abono. Obligatoria si se pagó en efectivo.
  sucursalId        Int?
  sucursal          Sucursal?   @relation(fields: [sucursalId], references: [id])
  nota              String?
  /// Generada al abrir el formulario: un doble envío no duplica el abono.
  claveIdempotencia String?     @unique
  /// Cierre que sumó el abono al efectivo. Solo abonos en efectivo; nulo = pendiente.
  cierreCajaId      Int?
  cierreCaja        CierreCaja? @relation(fields: [cierreCajaId], references: [id])
  /// Abono anulado: no resta del saldo ni suma en ningún cierre posterior a la anulación.
  anulado           Boolean     @default(false)
  anuladoEn         DateTime?
  anuladoPorId      Int?
  anuladoPor        Usuario?    @relation("AbonosAnulados", fields: [anuladoPorId], references: [id])
  motivoAnulacion   String?

  @@index([clienteId])
  @@index([sucursalId, cierreCajaId])
}

model MovimientoProveedor {
  id          Int                     @id @default(autoincrement())
  proveedorId Int
  proveedor   Proveedor               @relation(fields: [proveedorId], references: [id])
  compraId    Int?
  compra      Compra?                 @relation(fields: [compraId], references: [id])
  tipo        TipoMovimientoProveedor
  monto       Decimal                 @db.Decimal(10, 2)
  fecha       DateTime                @default(now())

  // Solo pagos. Los cargos y anulaciones salen de la compra.
  medioPago         MedioPagoProveedor?
  usuarioId         Int?
  usuario           Usuario?            @relation("PagosRegistrados", fields: [usuarioId], references: [id])
  /// Caja de la que salió el efectivo. Solo pagos con efectivo de caja.
  sucursalId        Int?
  sucursal          Sucursal?           @relation(fields: [sucursalId], references: [id])
  nota              String?
  /// Generada al abrir el formulario: un doble envío no duplica el pago.
  claveIdempotencia String?             @unique
  /// Cierre que descontó el pago del efectivo. Solo pagos de caja; nulo = pendiente.
  cierreCajaId      Int?
  cierreCaja        CierreCaja?         @relation(fields: [cierreCajaId], references: [id])
  /// Pago anulado: no resta del saldo ni sale de ningún cierre posterior a la anulación.
  anulado           Boolean             @default(false)
  anuladoEn         DateTime?
  anuladoPorId      Int?
  anuladoPor        Usuario?            @relation("PagosAnulados", fields: [anuladoPorId], references: [id])
  motivoAnulacion   String?

  @@index([proveedorId])
  @@index([sucursalId, cierreCajaId])
}

/// Arqueo de la caja de una sucursal. Cada cierre se queda con las ventas y
/// anulaciones que todavía no tenían cierre (`cierreCajaId`), así ninguna se
/// pierde ni se cuenta dos veces. Nunca se edita ni se borra.
model CierreCaja {
  id                   Int         @id @default(autoincrement())
  /// Momento del cierre: fin del período.
  fecha                DateTime    @default(now())
  /// Inicio del período: el momento del cierre anterior, o el inicio del día del primero.
  desde                DateTime
  usuarioId            Int
  usuario              Usuario     @relation("CierresRegistrados", fields: [usuarioId], references: [id])
  sucursalId           Int
  sucursal             Sucursal    @relation(fields: [sucursalId], references: [id])
  /// Único: dos cierres simultáneos no pueden colgar del mismo anterior.
  cierreAnteriorId     Int?        @unique
  cierreAnterior       CierreCaja? @relation("CadenaCierres", fields: [cierreAnteriorId], references: [id])
  cierreSiguiente      CierreCaja? @relation("CadenaCierres")
  /// Generada al abrir la pantalla: un doble envío no duplica el cierre.
  claveIdempotencia    String      @unique
  fondoInicial         Decimal     @db.Decimal(10, 2)
  ventasEfectivo       Decimal     @db.Decimal(10, 2)
  /// Ventas en efectivo de períodos ya cerrados, anuladas en este.
  devolucionesEfectivo Decimal     @db.Decimal(10, 2)
  ventasTransferencia  Decimal     @db.Decimal(10, 2)
  ventasTarjeta        Decimal     @db.Decimal(10, 2)
  ventasFiado          Decimal     @db.Decimal(10, 2)
  cantidadVentas       Int
  /// Efectivo esperado según el sistema.
  totalSistema         Decimal     @db.Decimal(10, 2)
  totalContado         Decimal     @db.Decimal(10, 2)
  /// contado − esperado: positiva es sobrante, negativa faltante.
  diferencia           Decimal     @db.Decimal(10, 2)
  /// Efectivo que queda en el cajón para el turno siguiente.
  fondoSiguiente       Decimal     @db.Decimal(10, 2)
  /// Billetes y monedas, si se contó con detalle: { "500": 3, "0.5": 4 }.
  detalleConteo        Json?
  notas                String?
  revisadoPorId        Int?
  revisadoPor          Usuario?    @relation("CierresRevisados", fields: [revisadoPorId], references: [id])
  revisadoEn           DateTime?
  notaRevision         String?
  /// Gastos pagados con el efectivo del cajón en este período.
  gastosCaja           Decimal     @default(0) @db.Decimal(10, 2)
  /// Abonos de clientes cobrados en efectivo en este período.
  abonosEfectivo       Decimal     @default(0) @db.Decimal(10, 2)
  /// Pagos a proveedores hechos con el efectivo del cajón en este período.
  pagosProveedorCaja   Decimal     @default(0) @db.Decimal(10, 2)

  ventas           Venta[]
  anulacionesVenta AnulacionVenta[]
  gastos           Gasto[]
  abonos           MovimientoCuenta[]
  pagosProveedor   MovimientoProveedor[]

  @@index([sucursalId, fecha])
}

/// Concepto de gasto (Alquiler, Fletes…). La categoría del gasto sale de acá.
model ConceptoGasto {
  id          Int            @id @default(autoincrement())
  nombre      String         @unique
  categoria   CategoriaGasto
  activo      Boolean        @default(true)
  gastos      Gasto[]
  gastosFijos GastoFijo[]
}

model Gasto {
  id                Int             @id @default(autoincrement())
  /// Día del pago (mediodía local). La hora real de registro es `creadoEn`.
  fecha             DateTime
  conceptoId        Int
  concepto          ConceptoGasto   @relation(fields: [conceptoId], references: [id])
  monto             Decimal         @db.Decimal(10, 2)
  medioPago         MedioPagoGasto
  descripcion       String
  numeroComprobante String?
  usuarioId         Int
  usuario           Usuario         @relation(fields: [usuarioId], references: [id])
  /// Nula = gasto general de la empresa. Obligatoria si se pagó con efectivo de caja.
  sucursalId        Int?
  sucursal          Sucursal?       @relation(fields: [sucursalId], references: [id])
  /// Generada al abrir el formulario: un doble envío no duplica el gasto.
  claveIdempotencia String          @unique
  anulado           Boolean         @default(false)
  anulacion         AnulacionGasto?
  /// Cierre que lo descontó del efectivo. Solo gastos de caja; nulo = pendiente.
  cierreCajaId      Int?
  cierreCaja        CierreCaja?     @relation(fields: [cierreCajaId], references: [id])
  /// Gasto fijo del que salió (Etapa 2). Marca ese gasto fijo como registrado en el mes.
  gastoFijoId       Int?
  gastoFijo         GastoFijo?      @relation(fields: [gastoFijoId], references: [id])
  creadoEn          DateTime        @default(now())

  @@index([fecha])
  @@index([sucursalId, cierreCajaId])
  @@index([conceptoId])
  @@index([gastoFijoId])
}

/// Recordatorio con plantilla de un gasto que se repite cada mes (alquiler,
/// salarios, servicios). Nunca registra nada solo.
model GastoFijo {
  id            Int            @id @default(autoincrement())
  conceptoId    Int
  concepto      ConceptoGasto  @relation(fields: [conceptoId], references: [id])
  descripcion   String
  /// Monto de referencia: el real se escribe al registrar el gasto.
  montoEstimado Decimal        @db.Decimal(10, 2)
  /// Día del mes en que se suele pagar, de 1 a 28.
  diaDelMes     Int
  medioPago     MedioPagoGasto
  sucursalId    Int?
  sucursal      Sucursal?      @relation(fields: [sucursalId], references: [id])
  activo        Boolean        @default(true)
  gastos        Gasto[]
}

model AnulacionGasto {
  id        Int      @id @default(autoincrement())
  gastoId   Int      @unique
  gasto     Gasto    @relation(fields: [gastoId], references: [id])
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  motivo    String
  fecha     DateTime @default(now())
}
